{
  "name": "leetgitsync",
  "private": true,
  "version": "1.0.0",
  "description": "Save accepted LeetCode solutions directly to a GitHub repository.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/VisheshAgarwal0089/leetgitsync.git"
  },
  "homepage": "https://github.com/VisheshAgarwal0089/leetgitsync",
  "bugs": {
    "url": "https://github.com/VisheshAgarwal0089/leetgitsync/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:brave": "wxt build -b brave",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:brave": "wxt zip -b brave",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3 --sources",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "simulate:scale": "node scripts/simulate-scale.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:sensitive": "node scripts/check-sensitive-data.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:store-docs": "node scripts/check-store-docs.mjs",
    "checksums": "node scripts/generate-checksums.mjs",
    "release:verify": "node scripts/release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.1.0",
    "wxt": "^0.21.4"
  }
}
